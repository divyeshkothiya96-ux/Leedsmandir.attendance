rules_version = '2';

// Paste this into Firebase: Firestore Database → Rules → Publish.
// Anyone signed in (the door login or the admin login) can see the counts, start an event and count.
// Only the admin login can delete events or change the temple name.
// Keep the admin list in step with adminEmails in config.js.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email in ['admin@mandir.local'];
    }

    function validEvent(d) {
      return d.keys().hasOnly(['name', 'date', 'createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.createdAt is number;
    }

    function validStation(d) {
      return d.keys().hasOnly(['label', 'count', 'hours', 'startedAt', 'updatedAt'])
        && d.label is string && d.label.size() <= 40
        && d.count is int && d.count > -100000 && d.count < 100000
        && d.hours is map && d.hours.size() <= 24
        && d.startedAt is number
        && d.updatedAt is number;
    }

    match /events/{eventId} {
      allow read: if signedIn();
      allow create: if signedIn() && validEvent(request.resource.data);
      allow update: if isAdmin() && validEvent(request.resource.data);
      allow delete: if isAdmin();

      // One document per phone session, holding that phone's tally for the event.
      match /stations/{stationId} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && exists(/databases/$(database)/documents/events/$(eventId))
          && validStation(request.resource.data);
        allow delete: if isAdmin();
      }
    }

    match /settings/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['name'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60;
    }
  }
}
